---
const links = [
  { label: "Docs", href: "/docs/overview" },
  { label: "Showroom", href: "/showroom" },
  { label: "GitHub ↗", href: "https://github.com/audiorective/audiorective" },
];
---

<nav class="site-nav" aria-label="Main navigation">
  <a class="brand" href="/">
    audiorective<span aria-hidden="true"> /</span>
  </a>
  <ul>
    {links.map((link) => (
      <li>
        <a href={link.href} aria-current={Astro.url.pathname.startsWith(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
<style>
  .site-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 20px max(24px, calc((100vw - 1120px) / 2));
    border-bottom: 1px solid var(--line);
  }
  .brand {
    font: 600 28px/1 var(--display);
    letter-spacing: -0.02em;
    color: var(--fg);
    text-decoration: none;
  }
  .brand span {
    color: var(--accent);
  }
  ul {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li a {
    font-size: 13px;
    color: var(--fg-dim);
    text-decoration: none;
    padding-block: 10px;
  }
  li a:hover,
  li a[aria-current] {
    color: var(--accent);
  }
  @media (max-width: 440px) {
    .site-nav {
      padding: 18px 20px;
      gap: 12px;
      flex-wrap: wrap;
    }
    ul {
      gap: 20px;
    }
    .brand {
      font-size: 25px;
    }
  }
</style>
