---
import type { Demo } from "../data/demos";

interface Props {
  demo: Demo;
}

const { demo } = Astro.props;
---

<article class="demo-card">
  <a class="thumb-link" href={demo.route}>
    <img class="thumb" src={demo.thumb} alt={`${demo.title} preview`} loading="lazy" />
  </a>
  <div class="body">
    <h2 class="title">{demo.title}</h2>
    <p class="blurb">{demo.blurb}</p>
    <ul class="packages">
      {demo.packages.map((pkg) => (
        <li class="pkg">{pkg}</li>
      ))}
    </ul>
    <div class="actions">
      <a class="open" href={demo.route}>
        Open demo →
      </a>
      <a class="source" href={demo.source} target="_blank" rel="noopener noreferrer">
        View source
      </a>
    </div>
  </div>
</article>

<style>
  .demo-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--bg-raised);
    overflow: hidden;
  }
  .demo-card:hover {
    border-color: var(--accent);
  }
  .thumb-link {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
  }
  .title {
    margin: 0;
    font: 600 28px/1.1 var(--display);
    color: var(--fg);
  }
  .blurb {
    margin: 0;
    color: var(--fg-dim);
    font-size: 14px;
    line-height: 1.6;
  }
  .packages {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
  }
  .pkg {
    font: 10px/1.5 var(--mono);
    color: var(--accent-2);
    border: 1px solid var(--line);
    padding: 4px 6px;
  }
  .actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .open {
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    font-size: 14px;
  }
  .source {
    color: var(--fg-dim);
    font-size: 12px;
    text-decoration: none;
  }
  .actions a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
