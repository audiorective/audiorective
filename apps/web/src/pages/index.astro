---
import BaseLayout from "../layouts/BaseLayout.astro";
import LandingDemo from "../components/landing/LandingDemo";
import "../styles/landing.css";
const sourceRef = process.env.VERCEL_GIT_COMMIT_SHA || "main";
const packages = [
  ["core", "The audio foundation", "Reactive parameters, samplers, loop and file players, analysis, spatial audio, and graph routing.", "/docs/core"],
  ["clock", "Time, in musical terms", "Transport, tempo automation, scheduling windows, and rulers for beats, bars, and seconds.", "/docs/clock"],
  ["effects", "Shape the signal", "Filters, delays, distortion, pitch shifting, dynamics, channel strips, and send buses.", "/docs/effects"],
  ["react", "Connect the interface", "Observe audio state with hooks. Read and change the engine directly from your components.", "/docs/react"],
  ["threejs", "Sound in a scene", "Share the audio context and let spatial sound follow your Three.js objects.", "/docs/threejs"],
  ["playcanvas", "Audio in your world", "Connect a PlayCanvas application to the engine and bind sound to entity transforms.", "/docs/playcanvas"],
  ["devtools", "Check the result", "Measure processor latency and assert it in browser-based audio tests.", "/docs/devtools"],
];
---

<BaseLayout
  title="Audiorective — Build audio for the web"
  description="Modular Web Audio tools for playback, reactive state, timing, effects, and spatial sound. Explore one engine through several live interfaces."
>
  <a class="skip-link" href="#main-content">
    Skip to content
  </a>
  <main id="main-content" class="landing">
    <section class="landing-hero">
      <div class="hero-copy">
        <p class="eyebrow">A toolkit for Web Audio</p>
        <h1>Sound, connected.</h1>
        <p class="hero-lede">
          Build the audio engine.
          <br />
          Give it any interface.
        </p>
        <p class="muted">Playback, timing, effects, and reactive state. Independent packages for instruments, games, and audio tools.</p>
        <div class="cta-row">
          <a class="cta cta--primary" href="/docs/get-started">
            Get started <span aria-hidden="true">↗</span>
          </a>
          <a class="cta" href="#packages">
            Explore the packages
          </a>
        </div>
        <div class="hero-caption">
          <span class="status-dot"></span> TypeScript · Web Audio · Open source
        </div>
      </div>
      <div class="hero-demo">
        <div class="instrument-label">
          <span>THE LANDING PAGE IS AN INSTRUMENT</span>
          <span>01—04</span>
        </div>
        <div id="hero-console" class="demo-host hero-console">
          <div class="console-placeholder">
            Loading the rhythm console…
            <br />
            <small>Four voices. One shared audio engine.</small>
          </div>
        </div>
        <p class="demo-caption">Start a beat. Keep shaping it as you explore.</p>
      </div>
    </section>
    <div class="capability-strip" aria-label="Capabilities">
      <span>Playback</span>
      <span>Reactive state</span>
      <span>Scheduling</span>
      <span>DSP effects</span>
      <span>Spatial audio</span>
    </div>
    <section class="feature-section" id="interfaces">
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 / Shared state</p>
          <h2>
            Different interfaces.
            <br />
            The same sound.
          </h2>
        </div>
        <p>Move the point in the canvas. The React controls follow. Both read and write the same audio parameters—no second store to keep in sync.</p>
      </div>
      <div id="shared-console" class="demo-host">
        <div class="console-placeholder">Loading the shared controls…</div>
      </div>
      <div class="section-footer">
        <code>filter.params.frequency.value = 2400</code>
        <a href="/docs/architecture">
          How state is shared <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section class="feature-section" id="timing">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / Timing</p>
          <h2>
            A pattern you can change.
            <br />A clock you can share.
          </h2>
        </div>
        <p>Edit the beat you started above. Change tempo while it plays. The clock schedules the notes; the interface follows the time you hear.</p>
      </div>
      <div id="pattern-console" class="demo-host">
        <div class="console-placeholder">Loading the pattern editor…</div>
      </div>
      <div class="section-footer">
        <span class="muted">Tap a step to add or remove a hit. Voice labels toggle mute.</span>
        <a href="/docs/clock">
          Explore the clock <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section class="feature-section" id="effects">
      <div class="section-heading">
        <div>
          <p class="eyebrow">03 / Signal processing</p>
          <h2>
            Small parts.
            <br />
            Your signal path.
          </h2>
        </div>
        <p>Filter the beat, add an echo, or bypass the filter. Effects expose the same reactive parameters as the rest of the engine.</p>
      </div>
      <div id="effects-console" class="demo-host">
        <div class="console-placeholder">Loading the effects strip…</div>
      </div>
      <div class="section-footer">
        <span class="muted">The effects package also includes pitch shifting, reverb, compression, and more.</span>
        <a href="/docs/effects">
          Explore effects <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section class="feature-section packages-section" id="packages">
      <div class="section-heading">
        <div>
          <p class="eyebrow">04 / The toolkit</p>
          <h2>
            Pick the pieces
            <br />
            your app needs.
          </h2>
        </div>
        <p>
          Start with core. Add timing, effects, or bindings as needed. The same primitives work in a drum machine, a spatial scene, or a custom audio
          tool.
        </p>
      </div>
      <div class="package-grid">
        {packages.map(([name, title, description, href]) => (
          <a class="package-card" href={href}>
            <div class="package-id">
              <code>@audiorective/{name}</code>
              <span aria-hidden="true">↗</span>
            </div>
            <h3>{title}</h3>
            <p>{description}</p>
          </a>
        ))}
      </div>
      <div class="toolkit-notes">
        <div>
          <h3>More than live playback</h3>
          <p>Render audio offline, align parallel paths with automatic delay compensation, and use sampler fades, reverse playback, and polyphony.</p>
          <a href="/docs/core">Playback, routing, and rendering ↗</a>
        </div>
        <div>
          <h3>Use your own renderer</h3>
          <p>The canvas above uses PixiJS with core directly. No Pixi-specific package is needed. Keep UI code separate from the audio engine.</p>
          <a href="/docs/pixijs">Read the PixiJS guide ↗</a>
        </div>
      </div>
    </section>
    <section class="feature-section start-section" id="start">
      <div>
        <p class="eyebrow">Make it yours</p>
        <h2>Start with a sound.</h2>
        <p>Install the packages for your app. Add the agent skills if you want your coding assistant to use the same patterns.</p>
        <div class="cta-row">
          <a class="cta cta--primary" href="/docs/get-started">
            Build your first app ↗
          </a>
          <a class="cta" href="/showroom">
            More working examples
          </a>
        </div>
      </div>
      <div class="install-block">
        <span class="tool-label">PACKAGES / THIS DEMO</span>
        <pre><code>npm install @audiorective/core @audiorective/clock @audiorective/effects @audiorective/react</code></pre>
        <span class="tool-label">AGENT SKILLS</span>
        <pre><code>npx skills add audiorective/audiorective</code></pre>
        <a href={`https://github.com/audiorective/audiorective/tree/${sourceRef}/apps/web/src/components/landing`}>Read the demo source ↗</a>
      </div>
    </section>
    <footer class="landing-footer">
      <a href="/" class="footer-brand">
        audiorective
      </a>
      <span>Built on the Web Audio API.</span>
      <a href="https://github.com/audiorective/audiorective">GitHub ↗</a>
    </footer>
  </main>
  <LandingDemo client:only="react" />
  <noscript>
    <p class="no-audio">
      The live instrument needs JavaScript. You can still explore the <a href="/docs/overview">documentation</a> and packages.
    </p>
  </noscript>
</BaseLayout>
