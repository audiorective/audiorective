---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DemoCard from "../../components/DemoCard.astro";
import { demos } from "../../data/demos";
---

<BaseLayout title="Showroom" description="Live demos built with the audiorective Web Audio primitives.">
  <main class="showroom">
    <header class="hero">
      <p class="eyebrow">Working examples</p>
      <h1>Explore the instruments.</h1>
      <p class="lede">Play, mix, and explore. Each example includes the source so you can see how it works.</p>
    </header>

    <div class="grid">
      {demos.map((demo) => (
        <DemoCard demo={demo} />
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .showroom {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .hero {
    max-width: 42rem;
    margin-bottom: 3rem;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--accent-2);
    letter-spacing: 0.08em;
    margin: 0 0 0.75rem;
  }

  .hero h1 {
    font: 600 3.5rem/1 var(--display);
    margin: 0 0 0.75rem;
    color: var(--fg);
  }

  .lede {
    margin: 0;
    color: var(--fg-dim);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem;
  }
</style>
