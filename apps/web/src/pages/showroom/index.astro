---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoCard from '../../components/DemoCard.astro';
import { demos } from '../../data/demos';
---

<BaseLayout
  title="Showroom"
  description="Live demos built with the audiorective Web Audio primitives."
>
  <main class="showroom">
    <header class="hero">
      <p class="eyebrow">// showroom</p>
      <h1>See it run.</h1>
      <p class="lede">
        Working demos, built on the audiorective packages. Every card links to a live
        demo and its source.
      </p>
    </header>

    <div class="grid">
      {demos.map((demo) => (
        <DemoCard demo={demo} />
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .showroom {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .hero {
    max-width: 42rem;
    margin-bottom: 3rem;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--accent-2);
    letter-spacing: 0.08em;
    margin: 0 0 0.75rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin: 0 0 0.75rem;
    background: linear-gradient(90deg, var(--fg), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lede {
    margin: 0;
    color: #a3a3c2;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: 1.5rem;
  }
</style>
